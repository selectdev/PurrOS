# Copy to purros.env (or run `purros init`, which fills in the secrets).
# --- Required -------------------------------------------------------------
# Public URL where PurrOS is reachable (used in links and the API spec)
PURROS_URL=https://erp.example.com
# At least 32 random characters: openssl rand -base64 32
# Keep a copy somewhere safe — encrypted data can't be read without it.
PURROS_SECRET=
# Password must match POSTGRES_PASSWORD in postgres.env
DATABASE_URL=postgres://purros:CHANGE-ME@db:5432/purros?sslmode=disable

# --- Optional -------------------------------------------------------------
# Run the webhook worker inside the API process (true) or separately with `purros worker` (false)
PURROS_RUN_WORKER=true
# Trust X-Forwarded-For from your reverse proxy
PURROS_TRUST_PROXY=true
LOG_LEVEL=info
API_RATE_LIMIT_PER_MIN=600
API_INGEST_RATE_LIMIT_PER_MIN=3000
API_MAX_BATCH_SIZE=1000
# Share rate limits across several API containers (docker compose --profile redis)
# REDIS_URL=redis://redis:6379

# Where PurrOS keeps uploaded files and backups (default ./state; the Docker
# image uses /var/lib/purros, on the "state" volume).
# PURROS_STATE_DIR=/var/lib/purros

# --- Backups (optional) -----------------------------------------------------
# Nightly backups into this directory. Leave empty to turn scheduled backups off.
PURROS_BACKUP_DIR=/var/lib/purros/backups
# PURROS_BACKUP_HOUR=2          # UTC
# PURROS_BACKUP_KEEP=14
# PURROS_BACKUP_PASSPHRASE=     # encrypt backups; keep it with PURROS_SECRET
# PURROS_BACKUP_FILES=auto      # include uploaded files: auto (with local storage), true, false
# Also upload every backup to an S3-compatible bucket (use a different bucket
# than file storage, ideally another provider or region):
# PURROS_BACKUP_S3_ENABLED=true
# PURROS_BACKUP_S3_BUCKET=acme-purros-backups
# PURROS_BACKUP_S3_REGION=eu-central-1
# PURROS_BACKUP_S3_ENDPOINT=    # empty for AWS
# PURROS_BACKUP_S3_ACCESS_KEY_ID=
# PURROS_BACKUP_S3_SECRET_ACCESS_KEY=
# PURROS_BACKUP_S3_KEEP=30

# --- File storage (optional) ------------------------------------------------
# Uploaded files (proof, photos, receipts…). Default: $PURROS_STATE_DIR/files.
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=acme-purros-files
# STORAGE_S3_REGION=eu-central-1
# STORAGE_S3_ENDPOINT=          # empty for AWS; e.g. http://minio:9000
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_FORCE_PATH_STYLE=false
# STORAGE_MAX_UPLOAD_MB=25

# --- Email (optional) -------------------------------------------------------
# Needed for invitation emails, magic links and password reset emails.
# Without it, use `purros users sign-in-link --email …` to share links by hand.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_FROM="Acme Operations <ops@acme.example>"
# SMTP_REPLY_TO=hr@acme.example
