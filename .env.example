# --- Required -------------------------------------------------------------
# Public URL where PurrOS is reachable (used in links and the API spec)
PURROS_URL=https://erp.example.com
# At least 32 random characters: openssl rand -base64 32
# Keep a copy somewhere safe — encrypted data can't be read without it.
PURROS_SECRET=
# Database password used by docker-compose.yml
POSTGRES_PASSWORD=

# --- Optional -------------------------------------------------------------
# Run the webhook worker inside the API process (true) or separately with `purros worker` (false)
PURROS_RUN_WORKER=true
# Trust X-Forwarded-For from your reverse proxy
PURROS_TRUST_PROXY=true
LOG_LEVEL=info
API_RATE_LIMIT_PER_MIN=600
API_INGEST_RATE_LIMIT_PER_MIN=3000
API_MAX_BATCH_SIZE=1000
# Share rate limits across several API containers (docker compose --profile redis)
# REDIS_URL=redis://redis:6379

# --- Email (optional) -------------------------------------------------------
# Needed for invitation emails, magic links and password reset emails.
# Without it, use `purros users sign-in-link --email …` to share links by hand.
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=
# SMTP_FROM="Acme Operations <ops@acme.example>"
# SMTP_REPLY_TO=hr@acme.example
